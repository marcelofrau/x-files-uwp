<UserControl
    x:Class="XFiles.Controls.NetworkLocationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <UserControl.Resources>
        <!-- Floating label chip: small caption that appears on the field's top
             border once the field is focused or has content. The Border's solid
             background masks the border line so it reads as an inline label.
             (UWP TextBlock has no Background, hence the Border wrapper.) -->
        <Style x:Key="FloatingFieldLabel" TargetType="Border">
            <Setter Property="Background" Value="#1A1D23" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8,-5,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="FloatingFieldLabelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource XFilesAccentBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Overlay" Background="#CC0D1117" KeyDown="OnOverlayKeyDown"
          IsHitTestVisible="True">
        <!-- Invisible focus sink: focusing a non-text control dismisses the
             on-screen keyboard and keeps focus inside the dialog (nothing
             leaks to the page behind). -->
        <ContentControl x:Name="FocusSink" IsTabStop="True" />
        <Border Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="520"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,72,0,0"
                Padding="24,16,24,14">

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Foreground="{StaticResource XFilesAccentBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="15"
                           Text="Network Location" />

                <TextBlock x:Name="StepIndicator"
                           Text="1 / 3 — Connection"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#8A93A0"
                           Margin="0,2,0,10" />

                <!-- Step 1: Name + Protocol + Host -->
                <Grid x:Name="Step1Panel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <TextBox x:Name="NameBox"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Padding="8,9,8,6"
                                 MinHeight="34"
                                 PlaceholderText="Name (optional)"
                                 HorizontalAlignment="Stretch"
                                 GotFocus="OnTextBoxGotFocus"
                                 LostFocus="OnTextBoxLostFocus"
                                 TextChanged="OnTextChanged"
                                 KeyDown="OnTextFieldKeyDown" />
                        <Border x:Name="NameLabel" Style="{StaticResource FloatingFieldLabel}">
                            <TextBlock Text="NAME" Style="{StaticResource FloatingFieldLabelText}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="2">
                        <ComboBox x:Name="ProtocolCombo"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  RequestedTheme="Dark"
                                  MinHeight="34"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"
                                  SelectionChanged="OnProtocolSelectionChanged"
                                  DropDownClosed="OnProtocolDropDownClosed"
                                  FontFamily="Consolas">
                            <ComboBoxItem Content="Windows Share (SMB)" Tag="Smb" />
                            <ComboBoxItem Content="FTP" Tag="Ftp" />
                            <ComboBoxItem Content="FTPS" Tag="Ftps" />
                            <ComboBoxItem Content="sFTP" Tag="Sftp" />
                            <ComboBoxItem Content="WebDAV" Tag="Webdav" />
                        </ComboBox>
                        <Border x:Name="ProtocolLabel" Style="{StaticResource FloatingFieldLabel}">
                            <TextBlock Text="PROTOCOL" Style="{StaticResource FloatingFieldLabelText}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="HostBox"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Padding="8,9,8,6"
                                     MinHeight="34"
                                     PlaceholderText="IP / Host"
                                     HorizontalAlignment="Stretch"
                                     GotFocus="OnTextBoxGotFocus"
                                     LostFocus="OnTextBoxLostFocus"
                                     TextChanged="OnTextChanged"
                                     KeyDown="OnTextFieldKeyDown" />
                            <Border x:Name="HostLabel" Style="{StaticResource FloatingFieldLabel}">
                                <TextBlock Text="IP / HOST" Style="{StaticResource FloatingFieldLabelText}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Column="2">
                            <TextBox x:Name="PortBox"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Padding="8,9,8,6"
                                     MinHeight="34"
                                     PlaceholderText="Port"
                                     HorizontalAlignment="Stretch"
                                     GotFocus="OnTextBoxGotFocus"
                                     LostFocus="OnTextBoxLostFocus"
                                     TextChanged="OnTextChanged"
                                     KeyDown="OnTextFieldKeyDown" />
                            <Border x:Name="PortLabel" Style="{StaticResource FloatingFieldLabel}">
                                <TextBlock Text="PORT" Style="{StaticResource FloatingFieldLabelText}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Step 2: User + Password -->
                <Grid x:Name="Step2Panel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="UserBox"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Padding="8,9,8,6"
                                 MinHeight="34"
                                 PlaceholderText="User (empty = guest)"
                                 HorizontalAlignment="Stretch"
                                 GotFocus="OnTextBoxGotFocus"
                                 LostFocus="OnTextBoxLostFocus"
                                 TextChanged="OnTextChanged"
                                 KeyDown="OnTextFieldKeyDown" />
                        <Border x:Name="UserLabel" Style="{StaticResource FloatingFieldLabel}">
                            <TextBlock Text="USER" Style="{StaticResource FloatingFieldLabelText}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <PasswordBox x:Name="PassBox"
                                     Style="{StaticResource DarkPasswordBoxStyle}"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Padding="8,9,8,6"
                                     MinHeight="34"
                                     PlaceholderText="Password"
                                     HorizontalAlignment="Stretch"
                                     GotFocus="OnTextBoxGotFocus"
                                     LostFocus="OnTextBoxLostFocus"
                                     PasswordChanged="OnPasswordChanged"
                                     KeyDown="OnTextFieldKeyDown" />
                        <Border x:Name="PassLabel" Style="{StaticResource FloatingFieldLabel}">
                            <TextBlock Text="PASSWORD" Style="{StaticResource FloatingFieldLabelText}" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="PassHintText"
                               Grid.Row="2"
                               Text="Leave empty to keep the saved password"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="#8A93A0"
                               Visibility="Collapsed"
                               Margin="0,2,0,0" />
                </Grid>

                <!-- Step 3: Share -->
                <Grid x:Name="Step3Panel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="ShareBox"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Padding="8,9,8,6"
                                 MinHeight="34"
                                 PlaceholderText="Share / Path (empty lists shares)"
                                 HorizontalAlignment="Stretch"
                                 GotFocus="OnTextBoxGotFocus"
                                 LostFocus="OnTextBoxLostFocus"
                                 TextChanged="OnTextChanged"
                                 KeyDown="OnTextFieldKeyDown" />
                        <Border x:Name="ShareLabel" Style="{StaticResource FloatingFieldLabel}">
                            <TextBlock Text="SHARE / PATH" Style="{StaticResource FloatingFieldLabelText}" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="UrlPreviewText"
                               Grid.Row="1"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#8A93A0"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0" />
                </Grid>

                <TextBlock x:Name="StatusText"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#8A93A0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,10,0,0" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="TestButton"
                            Grid.Column="0"
                            Style="{StaticResource ConfirmDialogButton}"
                            MinWidth="92"
                            Click="OnTestClicked">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/x.png"
                                   Width="18" Height="18" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Test"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                       Foreground="{StaticResource XFilesForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Style="{StaticResource ConfirmDialogButton}"
                            Margin="0,0,10,0"
                            Click="OnCancelClicked">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                                   Width="18" Height="18" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Cancel"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                       Foreground="{StaticResource XFilesForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="OkButton"
                            Grid.Column="3"
                            Style="{StaticResource ConfirmDialogButton}"
                            Click="OnOkClicked">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                                   Width="18" Height="18" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="OkButtonText"
                                       Text="Next"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                       Foreground="{StaticResource XFilesForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
