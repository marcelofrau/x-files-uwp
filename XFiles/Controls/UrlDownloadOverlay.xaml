<UserControl
    x:Class="XFiles.Controls.UrlDownloadOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid Background="#E60D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: title + URL -->
        <Border Grid.Row="0"
                Background="#CC0D1117"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Download from URL"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="15"
                           Foreground="{StaticResource XFilesAccentBrush}" />
                <TextBlock x:Name="UrlText"
                           Text=""
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#80FFFFFF"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- WebView -->
        <WebView x:Name="DownloadWebView"
                 Grid.Row="1"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 AllowFocusOnInteraction="False" />

        <!-- Status bar (visible while downloading) -->
        <Border x:Name="StatusBar"
                Grid.Row="2"
                Background="#CC1A1D23"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Visibility="Collapsed">
            <StackPanel>
                <ProgressBar x:Name="DownloadProgress"
                             Foreground="{StaticResource XFilesAccentBrush}"
                             Background="#252830"
                             Minimum="0" Maximum="100"
                             Value="0" />
                <TextBlock x:Name="StatusText"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="12"
                           Foreground="#80FFFFFF"
                           Text="Downloading..."
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Footer legend -->
        <Border Grid.Row="3"
                Background="#CC0D1117"
                Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                           Width="16" Height="16" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Close"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#80FFFFFF"
                               Margin="0,3,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                           Width="16" Height="16" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Click"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#80FFFFFF"
                               Margin="0,3,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/x.png"
                           Width="16" Height="16" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Back"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#80FFFFFF"
                               Margin="0,3,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Image Source="ms-appx:///Assets/GamepadButtons/analog/button_xbox_analog_l.png"
                           Width="18" Height="18" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Cursor"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#80FFFFFF"
                               Margin="0,3,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Image Source="ms-appx:///Assets/GamepadButtons/analog/button_xbox_analog_r.png"
                           Width="18" Height="18" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Scroll"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#80FFFFFF"
                               Margin="0,3,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="ms-appx:///Assets/GamepadButtons/dpads/dpad-all-directions.png"
                           Width="18" Height="18" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Scroll"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#80FFFFFF"
                               Margin="0,3,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
