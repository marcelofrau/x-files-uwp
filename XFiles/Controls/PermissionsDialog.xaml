<UserControl
    x:Class="XFiles.Controls.PermissionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#66000000">
        <Border x:Name="MainBorder"
                Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28,20">

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Image x:Name="HeaderIcon"
                           Source="ms-appx:///Assets/Views/FileActionSheet/fileactionsheet-permissions-48.png"
                           Width="40" Height="40" Margin="0,0,14,0"
                           VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Foreground="{StaticResource XFilesAccentBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                               FontSize="18"
                               Text="Permissions"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Background="#252830" Height="1" Margin="0,0,0,14" />

                <StackPanel x:Name="ReadOnlyRow"
                            Orientation="Horizontal"
                            Background="Transparent"
                            Padding="6,8"
                            Margin="0,0,0,4">
                    <Border x:Name="ReadOnlyBox"
                            Width="20" Height="20"
                            BorderBrush="#5A5E66"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="Transparent" />
                    <TextBlock Text="Read-only"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="14"
                               Foreground="{StaticResource XFilesForegroundBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="HiddenRow"
                            Orientation="Horizontal"
                            Background="Transparent"
                            Padding="6,8"
                            Margin="0,0,0,8">
                    <Border x:Name="HiddenBox"
                            Width="20" Height="20"
                            BorderBrush="#5A5E66"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="Transparent" />
                    <TextBlock Text="Hidden"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="14"
                               Foreground="{StaticResource XFilesForegroundBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="RecursiveRow"
                            Orientation="Horizontal"
                            Background="Transparent"
                            Padding="6,8"
                            Margin="0,0,0,8">
                    <Border x:Name="RecursiveBox"
                            Width="20" Height="20"
                            BorderBrush="#5A5E66"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="Transparent" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Apply to subfolders and files"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="14"
                                   Foreground="{StaticResource XFilesForegroundBrush}" />
                        <TextBlock Text="folder only"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource XFilesTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Background="#252830" Height="1" Margin="0,0,0,14" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                               Width="14" Height="14" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Apply"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                               Width="14" Height="14" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Cancel"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>