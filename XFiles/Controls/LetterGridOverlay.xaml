<UserControl
    x:Class="XFiles.Controls.LetterGridOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117" Tapped="OnOverlayTapped">
        <Border Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20,16"
                MinWidth="480"
                MaxWidth="560">

            <StackPanel>
                <TextBlock Text="Jump to Letter"
                           Foreground="#B0D8A0"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="16"
                           Padding="0,0,0,12" />

                <Border Background="#252830" Height="1" Margin="0,0,0,12" />

                <GridView x:Name="LetterGrid"
                          Style="{StaticResource RetroListViewStyle}"
                          ItemContainerStyle="{StaticResource RetroListViewItemStyle}"
                          SelectionMode="Single"
                          Padding="0">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="7"
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="52" Height="52"
                                    CornerRadius="6"
                                    Background="#252830"
                                    BorderBrush="#3A3D43"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding}"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                           FontSize="22"
                                           Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Padding="0,12,0,0">
                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                           Width="18" Height="18" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Back"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
                               Foreground="{StaticResource XFilesTextMutedBrush}"
                               Margin="0,3,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
