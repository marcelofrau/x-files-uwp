<UserControl
    x:Class="XFiles.Controls.TextEditorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid Background="#E60D1117">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Left Sidebar (15%) ═══ -->
        <Border Grid.Column="0"
                Background="#CC0D1117"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- File icon -->
                <Image x:Name="FileIconImage"
                       Grid.Row="0"
                       Width="64" Height="64"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- File name -->
                <TextBlock x:Name="FileNameText"
                           Grid.Row="2"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="13"
                           Foreground="#D4D4D4"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="" />

                <!-- Status badge -->
                <Border x:Name="StatusBadge"
                        Grid.Row="3"
                        CornerRadius="4"
                        Padding="10,2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="StatusText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
                               LineHeight="16"
                               Margin="0,2,0,-2"
                               Foreground="#000000"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Text="" />
                </Border>

                <!-- Encoding / line ending info -->
                <StackPanel x:Name="FileInfoPanel"
                            Grid.Row="6"
                            VerticalAlignment="Bottom">
                    <TextBlock x:Name="EncodingText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="10"
                               Foreground="#50FFFFFF"
                               TextAlignment="Center"
                               Text="" />
                    <TextBlock x:Name="LineEndingText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="10"
                               Foreground="#50FFFFFF"
                               TextAlignment="Center"
                               Text="" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Right: Editor Area (85%) ═══ -->
        <Grid Grid.Column="1">

            <!-- Hidden TextBox for virtual keyboard bridge -->
            <TextBox x:Name="KeyboardBridge"
                     Width="0" Height="0"
                     Opacity="0"
                     Margin="-1000"
                     TabIndex="-1" />

            <!-- Editor WebView -->
            <WebView x:Name="EditorWebView"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     AllowFocusOnInteraction="False" />

            <!-- Notification bar: file size warnings -->
            <Border x:Name="NotificationBar"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="#CC333333"
                    Padding="16,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="NotificationText"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="13"
                           Foreground="#FF9999"
                           TextWrapping="Wrap"
                           Text="" />
            </Border>

            <!-- Save toast (auto-hides) -->
            <Border x:Name="SaveToast"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,60"
                    Background="#CC2D2D2D"
                    CornerRadius="4"
                    Padding="16,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="SaveToastText"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="13"
                           Foreground="#93C43C"
                           Text="Saved" />
            </Border>

            <!-- Unsaved changes dialog overlay -->
            <Grid x:Name="UnsavedOverlay" Background="#CC0D1117"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Visibility="Collapsed" Tapped="OnUnsavedOverlayTapped">
            <Border x:Name="UnsavedDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A1D23"
                    BorderBrush="#2A2D33"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxWidth="440"
                    Padding="24,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Image Source="ms-appx:///Assets/Views/AlertDialog/alert-question-48.png"
                               Width="40" Height="40"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="UnsavedDialogTitle"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="15"
                                   Foreground="{StaticResource XFilesForegroundBrush}"
                                   Text="Unsaved changes"
                                   TextWrapping="Wrap"
                                   MaxWidth="340"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="UnsavedDialogMessage"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="13"
                               Foreground="#80FFFFFF"
                               Text="Save changes before closing?"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <StackPanel x:Name="UnsavedDialogButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="UnsavedSaveBtn"
                                Style="{StaticResource ConfirmDialogButton}"
                                Margin="0,0,8,0"
                                Click="OnUnsavedSaveClicked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                                       Width="18" Height="18" Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="Save"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                           Foreground="{StaticResource XFilesForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UnsavedDiscardBtn"
                                Style="{StaticResource ConfirmDialogButton}"
                                Margin="0,0,8,0"
                                Click="OnUnsavedDiscardClicked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="ms-appx:///Assets/GamepadButtons/abxy/x.png"
                                       Width="18" Height="18" Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="Discard"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                           Foreground="#E74C3C"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UnsavedCancelBtn"
                                Style="{StaticResource ConfirmDialogButton}"
                                Click="OnUnsavedCancelClicked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                                       Width="18" Height="18" Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="Cancel"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                           Foreground="{StaticResource XFilesForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>

            <!-- Footer legend -->
            <Border x:Name="FooterBar"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="#CC0D1117"
                    Padding="16,8">
                <StackPanel x:Name="FooterContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Close"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/x.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Backspace"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/y.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Enter"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Keyboard"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/system/xboxl_menu.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Save"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="|"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#40FFFFFF"
                               Margin="0,3,12,0"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/analog/button_xbox_analog_l.png"
                               Width="18" Height="18" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Cursor"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/dpads/dpad-all-directions.png"
                               Width="18" Height="18" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Navigate"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/analog/button_xbox_analog_r.png"
                               Width="18" Height="18" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Scroll"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="FooterStatusText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#60FFFFFF"
                               Margin="0,3,0,0"
                               VerticalAlignment="Center"
                               Text="" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
