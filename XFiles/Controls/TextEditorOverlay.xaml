<UserControl
    x:Class="XFiles.Controls.TextEditorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid Background="#E60D1117">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Left Sidebar (15%) ═══ -->
        <Border Grid.Column="0"
                Background="#CC0D1117"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- File icon -->
                <Image x:Name="FileIconImage"
                       Grid.Row="0"
                       Width="64" Height="64"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- File name -->
                <TextBlock x:Name="FileNameText"
                           Grid.Row="2"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="13"
                           Foreground="#D4D4D4"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="" />

                <!-- Dirty badge (yellow dot) -->
                <Ellipse x:Name="DirtyBadge"
                         Grid.Row="3"
                         Width="6" Height="6"
                         Fill="#F1C40F"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />

                <!-- Status indicator -->
                <TextBlock x:Name="StatusText"
                           Grid.Row="4"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="11"
                           Foreground="#93C43C"
                           TextAlignment="Center"
                           Text="" />

                <!-- Encoding / line ending info -->
                <StackPanel x:Name="FileInfoPanel"
                            Grid.Row="6"
                            VerticalAlignment="Bottom">
                    <TextBlock x:Name="EncodingText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="10"
                               Foreground="#50FFFFFF"
                               TextAlignment="Center"
                               Text="" />
                    <TextBlock x:Name="LineEndingText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="10"
                               Foreground="#50FFFFFF"
                               TextAlignment="Center"
                               Text="" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Right: Editor Area (85%) ═══ -->
        <Grid Grid.Column="1">

            <!-- Hidden TextBox for virtual keyboard bridge -->
            <TextBox x:Name="KeyboardBridge"
                     Width="0" Height="0"
                     Opacity="0"
                     Margin="-1000"
                     TabIndex="-1" />

            <!-- Editor WebView -->
            <WebView x:Name="EditorWebView"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     AllowFocusOnInteraction="False" />

            <!-- Notification bar: file size warnings -->
            <Border x:Name="NotificationBar"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="#CC333333"
                    Padding="16,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="NotificationText"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="13"
                           Foreground="#FF9999"
                           TextWrapping="Wrap"
                           Text="" />
            </Border>

            <!-- Save toast (auto-hides) -->
            <Border x:Name="SaveToast"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,60"
                    Background="#CC2D2D2D"
                    CornerRadius="4"
                    Padding="16,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="SaveToastText"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="13"
                           Foreground="#93C43C"
                           Text="Saved" />
            </Border>

            <!-- Unsaved changes dialog -->
            <Border x:Name="UnsavedDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#E61A1D23"
                    CornerRadius="6"
                    Padding="24,20"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="UnsavedDialogTitle"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="16"
                               Foreground="#D4D4D4"
                               Text="Unsaved changes"
                               Margin="0,0,0,12" />
                    <TextBlock x:Name="UnsavedDialogMessage"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="13"
                               Foreground="#80FFFFFF"
                               Text="Save changes before closing?"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <StackPanel x:Name="UnsavedDialogButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel x:Name="UnsavedSaveBtn" Orientation="Horizontal" Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                                   Width="14" Height="14" Margin="0,0,4,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Save"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                       FontSize="12" Foreground="#93C43C"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="UnsavedDiscardBtn" Orientation="Horizontal" Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/x.png"
                                   Width="14" Height="14" Margin="0,0,4,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Discard"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                       FontSize="12" Foreground="#E74C3C"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="UnsavedCancelBtn" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                                   Width="14" Height="14" Margin="0,0,4,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Cancel"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                       FontSize="12" Foreground="#80FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer legend -->
            <Border x:Name="FooterBar"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="#CC0D1117"
                    Padding="16,8">
                <StackPanel x:Name="FooterContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Close"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/x.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Backspace"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/y.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Enter"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Keyboard"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/system/xboxl_menu.png"
                               Width="16" Height="16" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Save"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="|"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#40FFFFFF"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/analog/button_xbox_analog_l.png"
                               Width="18" Height="18" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Cursor"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/dpads/dpad-all-directions.png"
                               Width="18" Height="18" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Navigate"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/analog/button_xbox_analog_r.png"
                               Width="18" Height="18" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Scroll"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="FooterStatusText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#60FFFFFF"
                               VerticalAlignment="Center"
                               Text="" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
