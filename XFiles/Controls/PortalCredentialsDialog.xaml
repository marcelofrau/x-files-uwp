<UserControl
    x:Class="XFiles.Controls.PortalCredentialsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117" Tapped="OnOverlayTapped" KeyDown="OnOverlayKeyDown"
          IsHitTestVisible="True">
        <Border Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="520"
                MaxWidth="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24,20">

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Foreground="{StaticResource XFilesAccentBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="15"
                           Margin="0,0,0,4"
                           Text="Portal Credentials" />

                <TextBlock Text="Xbox Developer Mode Device Portal (HTTP Basic). Stored locally in SQLite — the console has no .env."
                           FontFamily="ms-appx:///Assets/Fonts/Inconsolata-Regular.ttf#Inconsolata"
                           FontSize="12"
                           Foreground="#8A93A0"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="User"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="12"
                           Foreground="#8A93A0"
                           Margin="0,0,0,4" />
                <TextBox x:Name="UserBox"
                         FontFamily="ms-appx:///Assets/Fonts/Inconsolata-Regular.ttf#Inconsolata"
                         FontSize="15"
                         Foreground="{StaticResource XFilesForegroundBrush}"
                         Background="#0F1318"
                         BorderBrush="{StaticResource XFilesInputBorderBrush}"
                         BorderThickness="1"
                         Padding="8,6"
                         MaxWidth="850"
                         HorizontalAlignment="Stretch"
                         GotFocus="OnUserGotFocus"
                         KeyDown="OnUserKeyDown" />

                <TextBlock Text="Password"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="12"
                           Foreground="#8A93A0"
                           Margin="0,10,0,4" />
                <PasswordBox x:Name="PassBox"
                             FontFamily="ms-appx:///Assets/Fonts/Inconsolata-Regular.ttf#Inconsolata"
                             FontSize="15"
                             Foreground="{StaticResource XFilesForegroundBrush}"
                             Background="#0F1318"
                             BorderBrush="{StaticResource XFilesInputBorderBrush}"
                             BorderThickness="1"
                             Padding="8,6"
                             MaxWidth="850"
                             HorizontalAlignment="Stretch"
                             KeyDown="OnPassKeyDown" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">

                    <Button x:Name="CancelButton"
                            Style="{StaticResource ConfirmDialogButton}"
                            Click="OnCancelClicked"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                                   Width="18" Height="18" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Cancel"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                       Foreground="{StaticResource XFilesForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="OkButton"
                            Style="{StaticResource ConfirmDialogButton}"
                            Click="OnOkClicked">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                                   Width="18" Height="18" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Save"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                       Foreground="{StaticResource XFilesForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
