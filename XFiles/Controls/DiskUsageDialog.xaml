<UserControl
    x:Class="XFiles.Controls.DiskUsageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117">
        <Border x:Name="MainBorder"
                Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="560"
                MaxWidth="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32,24">

            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Image Source="ms-appx:///Assets/Views/DiskUsageDialog/diskusagedialog-hdd-100.png"
                           Width="56" Height="56" Margin="0,0,16,0"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Foreground="{StaticResource XFilesAccentBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="20"
                                   Text="Disk Space" />
                        <TextBlock x:Name="DriveText"
                                   Foreground="{StaticResource XFilesForegroundBrush}"
                                   FontFamily="ms-appx:///Assets/Inconsolata-Regular.ttf#Inconsolata"
                                   FontSize="13"
                                   Margin="0,4,0,0"
                                   Text="" />
                    </StackPanel>
                </StackPanel>

                <!-- Content: one pie + stats per volume, built in code-behind -->
                <StackPanel x:Name="VolumesPanel" HorizontalAlignment="Center" />

                <!-- Close hint -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                           Width="14" Height="14" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Close"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11"
                               Foreground="{StaticResource XFilesTextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
