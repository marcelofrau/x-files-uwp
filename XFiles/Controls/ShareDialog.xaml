<UserControl
    x:Class="XFiles.Controls.ShareDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117" Tapped="OnOverlayTapped">
        <Border Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                MinWidth="380"
                MaxWidth="500">

            <StackPanel HorizontalAlignment="Center">
                <!-- Title -->
                <TextBlock Text="Log Shared"
                           Foreground="#B0D8A0"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <!-- QR Code -->
                <Border Background="#FFFFFF"
                        CornerRadius="4"
                        Padding="8"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <Image x:Name="QrImage"
                           Width="250" Height="250"
                           Stretch="Uniform" />
                </Border>

                <!-- URL -->
                <TextBlock x:Name="UrlText"
                           Foreground="#999999"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           Margin="0,0,0,4" />

                <!-- Hint -->
                <TextBlock x:Name="HintText"
                           Text="Scan QR code or open the link above"
                           Foreground="#555555"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <!-- Footer -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                           Width="18" Height="18"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Close"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
                               Margin="4,3,0,0"
                               Foreground="{StaticResource XFilesTextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
