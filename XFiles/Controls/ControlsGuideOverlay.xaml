<UserControl
    x:Class="XFiles.Controls.ControlsGuideOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid Background="#E80D1117" Tapped="OnBackdropTapped">
        <Grid Margin="56,32,56,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: gamepad reference -->
                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Text="Game Controls"
                               Foreground="{StaticResource XFilesAccentBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                               FontSize="30" />
                    <TextBlock Text="Complete controller mapping reference"
                               Foreground="{StaticResource XFilesTextMutedBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="14"
                               Margin="0,4,0,20" />

                    <Border Background="#1A1D23"
                            BorderBrush="#2A2D33"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <Image Source="ms-appx:///Assets/GamepadButtons/full-gamepad.png"
                               Width="220"
                               HorizontalAlignment="Center"
                               Stretch="Uniform" />
                    </Border>

                    <TextBlock Text="Sticks move selection and control volume depending on context."
                               Foreground="{StaticResource XFilesTextDimBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0" />
                </StackPanel>

                <!-- Right: mapping sections -->
                <ScrollViewer x:Name="GuideScrollViewer"
                              Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              IsScrollInertiaEnabled="True">
                    <ItemsControl x:Name="SectionsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1D23"
                                        BorderBrush="#2A2D33"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18,14"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource XFilesAccentBrush}"
                                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                                   FontSize="15"
                                                   Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Icon}"
                                                               Width="24" Height="24"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}"
                                                                   Grid.Column="1"
                                                                   Foreground="#FFE0E0E0"
                                                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Grid.Column="2"
                                                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Footer: close legend -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,10,0,0">
                <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                       Width="18" Height="18" Margin="0,0,6,0"
                       VerticalAlignment="Center" />
                <TextBlock Text="Close"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="13"
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
