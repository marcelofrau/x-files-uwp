<UserControl
    x:Class="XFiles.Controls.OperationProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117">
        <Border x:Name="MainBorder"
                Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                Width="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32,24">

            <StackPanel>
                <!-- Operation title -->
                <TextBlock x:Name="TitleText"
                           Foreground="{StaticResource XFilesAccentBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="18"
                           Margin="0,0,0,14"
                           Text="" />

                <!-- Source -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="From:"
                               Foreground="#66FFFFFF"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SourceText"
                               Grid.Column="1"
                               Foreground="{StaticResource XFilesForegroundBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="" />
                </Grid>

                <!-- Destination -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="To:"
                               Foreground="#66FFFFFF"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DestText"
                               Grid.Column="1"
                               Foreground="{StaticResource XFilesForegroundBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="" />
                </Grid>

                <!-- Live speed chart (60s window; stretches to the same width as the
                     progress bars below so the trace never rescales) -->
                <Border x:Name="SpeedChartPanel"
                        Visibility="Collapsed"
                        Background="#14171C"
                        BorderBrush="#2A2D33"
                        BorderThickness="1"
                        CornerRadius="4"
                        Height="84"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid x:Name="SpeedChartArea" Margin="12,24,12,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Center"
                                       Fill="#26FFFFFF" />
                            <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Center"
                                       Fill="#26FFFFFF" />
                            <Rectangle Grid.Row="3" Height="1" VerticalAlignment="Center"
                                       Fill="#26FFFFFF" />
                            <Polygon x:Name="SpeedFillArea"
                                     Grid.RowSpan="4"
                                     Fill="#2693C43C"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
                            <Polyline x:Name="SpeedPolyline"
                                      Grid.RowSpan="4"
                                      Stroke="{StaticResource XFilesAccentBrush}"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Text="Speed"
                                   Foreground="#66FFFFFF"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   Margin="12,7,0,0"
                                   VerticalAlignment="Top" />
                        <TextBlock x:Name="SpeedValueText"
                                   Foreground="{StaticResource XFilesAccentBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="14"
                                   Margin="0,4,12,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Text="" />
                    </Grid>
                </Border>

                <!-- Overall progress bar (multi-file) -->
                <StackPanel x:Name="OverallProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="OverallLabel"
                               Foreground="#66FFFFFF"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11"
                               Margin="0,0,0,4"
                               Text="Overall" />
                    <ProgressBar x:Name="OverallProgressBar"
                                 Style="{StaticResource RetroProgressBarStyle}"
                                 Minimum="0" Maximum="100"
                                 Value="0"
                                 Height="10"
                                 Margin="0,0,0,12" />
                </StackPanel>

                <!-- Per-file progress bar -->
                <ProgressBar x:Name="ProgressBar"
                             Style="{StaticResource RetroProgressBarStyle}"
                             Minimum="0" Maximum="100"
                             Value="0"
                             Height="14"
                             Margin="0,0,0,8" />

                <!-- Current file + bytes (bytes right-aligned) -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentFileText"
                               Grid.Column="0"
                               Foreground="#99FFFFFF"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Text="" />
                    <TextBlock x:Name="BytesText"
                               Grid.Column="1"
                               Foreground="#66FFFFFF"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
                               TextAlignment="Right"
                               Text="" />
                </Grid>

                <!-- Live stats: percent (left) / speed + ETA (right-aligned) -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PercentText"
                               Grid.Column="0"
                               Foreground="{StaticResource XFilesAccentBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                               FontSize="26"
                               TextAlignment="Left"
                               VerticalAlignment="Center"
                               Text="" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="SpeedText"
                                   Foreground="{StaticResource XFilesForegroundBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="13"
                                   MinWidth="140"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="" />
                        <TextBlock x:Name="EtaText"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="13"
                                   MinWidth="120"
                                   TextAlignment="Right"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="" />
                    </StackPanel>
                </Grid>

                <!-- Cancel hint -->
                <StackPanel x:Name="CancelHint"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,0">
                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                           Width="14" Height="14" Margin="0,0,4,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Cancel"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11"
                               Foreground="{StaticResource XFilesTextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Cancelled summary (shown after cancel) -->
                <StackPanel x:Name="SummaryPanel" Visibility="Collapsed"
                            Margin="0,18,0,0">
                    <Border Background="#1A2A1A"
                            BorderBrush="#3393C43C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16,12">
                        <StackPanel>
                            <TextBlock x:Name="SummaryTitle"
                                       Foreground="{StaticResource XFilesAccentBrush}"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                       FontSize="14"
                                       Margin="0,0,0,8"
                                       Text="Operation Cancelled" />
                            <TextBlock x:Name="SummaryText"
                                       Foreground="{StaticResource XFilesForegroundBrush}"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
