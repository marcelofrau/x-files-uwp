                            <FontIcon Glyph="&#xE8D6;" FontSize="80" HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource XFilesAccentDimBrush}" />
                        </Grid>
                        <!-- Loading spinner — spins over the album-art area -->
                        <ProgressRing x:Name="FsLoadingSpinner" Width="48" Height="48"
                                      IsActive="False" Visibility="Collapsed"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{StaticResource XFilesAccentBrush}" />
                    </Grid>
                </StackPanel>

            <!-- VU Meter -->
