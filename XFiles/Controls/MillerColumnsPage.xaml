                    <StackPanel>
                        <TextBlock Text="SELECT VISUALIZER"
                                   Foreground="#66FFFFFF"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Padding="20,4,20,4" />
                        <TextBlock x:Name="FsPickerCurrentLabel"
                                   Foreground="{StaticResource XFilesAccentBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="13" Padding="20,0,20,8" />
