<Page
    x:Class="XFiles.Controls.MillerColumnsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XFiles.Controls"
    xmlns:local="using:XFiles.Controls"
    xmlns:vis="using:XFiles.Visualizers"
    Background="#0D1117"
    IsTabStop="True">

    <Page.Resources>
        <local:BooleanToBrushConverter x:Key="BoolToHighlightBrush"
            TrueBrush="{StaticResource XFilesAccentBrush}"
            FalseBrush="{StaticResource XFilesTextMutedBrush}" />
        <local:BooleanToColumnWidthConverter x:Key="BatchCheckWidthConverter" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:EntrySeparatorSelector x:Key="ParentItemSelector">
            <local:EntrySeparatorSelector.DefaultTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="12,3,12,3">
                        <Image Source="{Binding Icon}"
                               Width="18" Height="18"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{Binding IsHighlighted, Converter={StaticResource BoolToHighlightBrush}}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="14"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </local:EntrySeparatorSelector.DefaultTemplate>
            <local:EntrySeparatorSelector.SeparatorTemplate>
                <DataTemplate>
                    <Border Height="1" Background="#252830" Margin="24,4" />
                </DataTemplate>
            </local:EntrySeparatorSelector.SeparatorTemplate>
        </local:EntrySeparatorSelector>
        <local:EntrySeparatorSelector x:Key="CurrentItemSelector">
            <local:EntrySeparatorSelector.DefaultTemplate>
                <DataTemplate>
                    <Grid Margin="4,3,8,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding IsBatchMode, ElementName=PageRoot, Converter={StaticResource BatchCheckWidthConverter}}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BatchCheck"
                                Grid.Column="0"
                                Width="14" Height="14"
                                CornerRadius="3"
                                BorderBrush="#5593C43C"
                                BorderThickness="1"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Visibility="Collapsed">
                            <Border x:Name="BatchCheckFill"
                                    Background="#93C43C"
                                    CornerRadius="2"
                                    Margin="2"
                                    Visibility="Collapsed" />
                        </Border>
                        <Image Grid.Column="1"
                               Source="{Binding Icon}"
                               Width="20" Height="20"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   x:Name="ItemNameText"
                                   Text="{Binding Name}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="15"
                                   Margin="0,3,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SizeDisplay}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   Margin="12,3,0,0"
                                   Foreground="{StaticResource XFilesTextDimBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </local:EntrySeparatorSelector.DefaultTemplate>
            <local:EntrySeparatorSelector.SeparatorTemplate>
                <DataTemplate>
                    <Border Height="1" Background="#252830" Margin="24,4" />
                </DataTemplate>
            </local:EntrySeparatorSelector.SeparatorTemplate>
        </local:EntrySeparatorSelector>
    </Page.Resources>

    <Grid>
        <!-- Main layout -->
        <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Background="#284325" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Grid.Column="0" Grid.RowSpan="2"
                   Source="ms-appx:///Assets/logo.png"
                   Height="24"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />

            <TextBlock Grid.Column="2" Grid.Row="0"
                       x:Name="VersionText"
                       Text=""
                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                       FontSize="10"
                       Foreground="{StaticResource XFilesTextDimBrush}"
                       Margin="0,0,4,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Grid.Row="1"
                       x:Name="PathText"
                       Text=""
                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                       FontSize="12"
                       Foreground="{StaticResource XFilesAccentBrush}"
                       Margin="0,2,4,0"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- ═══ COLUMNS ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*" />
                <ColumnDefinition Width="35*" />
                <ColumnDefinition Width="40*" />
            </Grid.ColumnDefinitions>

            <!-- Parent column (left) -->
            <Grid Grid.Column="0" x:Name="ParentColumn" Background="#0F1318"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ParentColumnSlide" X="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                    x:Name="ParentHeader"
                    Text=""
                    Foreground="{StaticResource XFilesAccentBrush}"
                    FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                    FontSize="14"
                    Padding="12,8,12,4"
                    TextTrimming="CharacterEllipsis" />

                <ListView Grid.Row="1"
                    x:Name="ParentList"
                    Padding="0"
                    Style="{StaticResource RetroListViewStyle}"
                    ItemContainerStyle="{StaticResource RetroListViewItemStyle}"
                    ItemTemplateSelector="{StaticResource ParentItemSelector}"
                    IsHitTestVisible="False"
                    Opacity="0.6">
                </ListView>

                <TextBlock Grid.Row="2"
                    x:Name="ParentStatus"
                    Text=""
                    Foreground="{StaticResource XFilesTextDimBrush}"
                    FontSize="12"
                    FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                    Padding="12,6,12,6" />

                <!-- Welcome panel — shown at root (no parent) -->
                <Grid x:Name="WelcomePanel" Grid.Row="0" Grid.RowSpan="3"
                      Visibility="Collapsed" Background="#0F1318">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center"
                                Margin="0,36,0,0">
                        <Image Source="ms-appx:///Assets/logo.png"
                               Height="56" HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                        <TextBlock Text="Gamepad Driven Filebrowser"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Tagline -->
                    <TextBlock Grid.Row="1"
                               Text="Browse files and folders&#x0a;with your gamepad"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="13" Foreground="#66FFFFFF"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="16,0,16,0" />

                    <!-- File type icons row -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image Source="ms-appx:///Assets/Views/FileActionSheet/ctx-folder-120.png"
                               Width="28" Height="28" Margin="0,0,6,0" Opacity="0.5" />
                        <Image Source="ms-appx:///Assets/Views/FileActionSheet/ctx-image-120.png"
                               Width="28" Height="28" Margin="0,0,6,0" Opacity="0.5" />
                        <Image Source="ms-appx:///Assets/Views/FileActionSheet/ctx-video-120.png"
                               Width="28" Height="28" Margin="0,0,6,0" Opacity="0.5" />
                        <Image Source="ms-appx:///Assets/Views/FileActionSheet/ctx-audio-120.png"
                               Width="28" Height="28" Margin="0,0,6,0" Opacity="0.5" />
                        <Image Source="ms-appx:///Assets/Views/FileActionSheet/ctx-text-120.png"
                               Width="28" Height="28" Margin="0,0,6,0" Opacity="0.5" />
                        <Image Source="ms-appx:///Assets/Views/FileActionSheet/ctx-archive-120.png"
                               Width="28" Height="28" Opacity="0.5" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Current column (center) — has focus -->
            <Grid Grid.Column="1" x:Name="CurrentColumn" Background="#141820"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CurrentColumnSlide" X="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                    x:Name="CurrentHeader"
                    Text=""
                    Foreground="{StaticResource XFilesAccentBrush}"
                    FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                    FontSize="14"
                    Padding="12,8,12,4"
                    TextTrimming="CharacterEllipsis" />

                <Grid Grid.Row="1">
                    <controls:RetroListView
                        x:Name="CurrentList"
                        Padding="0"
                        Style="{StaticResource RetroListViewStyle}"
                        ItemContainerStyle="{StaticResource RetroListViewItemStyle}"
                        SelectionChanged="CurrentList_SelectionChanged"
                        KeyDown="CurrentList_KeyDown"
                        ContainerContentChanging="OnCurrentListContainerChanging">
                    <controls:RetroListView.ItemTemplateSelector>
                        <StaticResource ResourceKey="CurrentItemSelector" />
                    </controls:RetroListView.ItemTemplateSelector>
                    </controls:RetroListView>
                </Grid>

                <!-- Loading indicator for current column -->
                <StackPanel Grid.Row="1"
                    x:Name="CurrentLoading"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="32" Height="32"
                                  Foreground="{StaticResource XFilesAccentBrush}" />
                    <TextBlock Text="Loading..."
                               Foreground="{StaticResource XFilesTextMutedBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="14"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Portal banner — shown when current column is inside the web portal -->
                <Grid Grid.Row="2" x:Name="PortalBanner"
                      Visibility="Collapsed"
                      Background="#2A2110">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Source="ms-appx:///Assets/Views/MillerColumnsPage/millercolumnspage-portal-banner-48.png"
                           Width="14" Height="14" Margin="12,0,8,0"
                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Web portal access — files load via the Xbox Dev Portal, slower/limited vs local drives"
                               Foreground="#D0B060"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="10"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="3"
                               Padding="0,6,12,6"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="3"
                    x:Name="CurrentStatus"
                    Text=""
                    Foreground="{StaticResource XFilesTextDimBrush}"
                    FontSize="12"
                    FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                    Padding="12,6,12,6" />
            </Grid>

            <!-- Preview column (right) -->
            <Grid Grid.Column="2" x:Name="PreviewColumn" Background="#0F1318"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PreviewColumnSlide" X="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                    x:Name="PreviewHeader"
                    Text=""
                    Foreground="{StaticResource XFilesAccentBrush}"
                    FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                    FontSize="14"
                    Padding="12,8,12,4"
                    TextTrimming="CharacterEllipsis" />

                <!-- Preview content: folder listing -->
                <ListView Grid.Row="1"
                    x:Name="PreviewList"
                    Padding="0"
                    Style="{StaticResource RetroListViewStyle}"
                    ItemContainerStyle="{StaticResource RetroListViewItemStyle}"
                    IsHitTestVisible="False"
                    Opacity="0.7">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="12,3,12,3">
                                <Image Source="{Binding Icon}"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource XFilesTextMutedBrush}"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                           FontSize="14"
                                           Margin="0,3,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Preview content: text file (plain) -->
                <ScrollViewer Grid.Row="1"
                    x:Name="PreviewTextScroll"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Padding="12,8">
                    <TextBlock x:Name="PreviewTextBlock"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="#CCCCCC"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </ScrollViewer>

                <!-- Preview content: source code (syntax highlighted) -->
                <WebView Grid.Row="1"
                    x:Name="PreviewCodeView"
                    DefaultBackgroundColor="#0F1318"
                    Visibility="Collapsed" />

                <!-- Preview content: image file -->
                <Grid Grid.Row="1"
                    x:Name="PreviewImagePanel"
                    Visibility="Collapsed"
                    Background="#0F1318">
                    <Image x:Name="PreviewImage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform" />
                </Grid>

                <!-- Preview content: audio/video -->
                <Grid Grid.Row="1"
                    x:Name="PreviewMediaPanel"
                    Visibility="Collapsed"
                    Background="#0F1318">
                    <controls:MediaPreviewControl x:Name="MediaPreview" />
                </Grid>

                <!-- Preview content: error -->
                <Grid Grid.Row="1"
                    x:Name="PreviewErrorPanel"
                    Visibility="Collapsed"
                    Background="#0F1318">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="280">
                        <Image x:Name="PreviewErrorIcon"
                               Width="96" Height="96"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                        <TextBlock x:Name="PreviewErrorTitle"
                            Foreground="#FFE0E0E0"
                            FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                            FontSize="20"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewErrorText"
                            Foreground="{StaticResource XFilesTextMutedBrush}"
                            FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Preview content: unsupported file type -->
                <Grid Grid.Row="1"
                    x:Name="PreviewUnsupportedPanel"
                    Visibility="Collapsed"
                    Background="#0F1318">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="280">
                        <Image x:Name="PreviewUnsupportedIcon"
                               Width="96" Height="96"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                        <TextBlock x:Name="PreviewUnsupportedFileName"
                            Foreground="#FFE0E0E0"
                            FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                            FontSize="20"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="2" />
                        <TextBlock Text="No Preview"
                            Foreground="{StaticResource XFilesTextMutedBrush}"
                            FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Margin="0,6,0,0" />
                        <TextBlock x:Name="PreviewUnsupportedType"
                            Foreground="{StaticResource XFilesTextMutedBrush}"
                            FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Margin="0,8,0,0" />
                        <TextBlock x:Name="PreviewUnsupportedSize"
                            Foreground="{StaticResource XFilesTextDimBrush}"
                            FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Preview content: archive media (extract to preview) -->
                <Grid Grid.Row="1"
                    x:Name="PreviewArchiveMediaPanel"
                    Visibility="Collapsed"
                    Background="#0F1318">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="260">
                        <Image Source="ms-appx:///Assets/Views/FileActionSheet/ctx-archive-120.png"
                               Width="80" Height="80"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"
                               Opacity="0.6" />
                        <TextBlock Text="Media inside archive"
                            Foreground="#FFE0E0E0"
                            FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                            FontSize="18"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <TextBlock Text="Extract the archive to preview audio and video files"
                            Foreground="{StaticResource XFilesTextMutedBrush}"
                            FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                            FontSize="13"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Margin="0,10,0,0" />
                        <Border CornerRadius="6"
                                Background="#1A2A12"
                                BorderBrush="#2A3A1A"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Press "
                                    Foreground="{StaticResource XFilesTextDimBrush}"
                                    FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                    FontSize="13"
                                    VerticalAlignment="Center" />
                                <Border Background="#93C43C" CornerRadius="4"
                                        Padding="6,4" Margin="4,0">
                                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/y.png"
                                           Width="18" Height="18"
                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text=" to extract"
                                    Foreground="{StaticResource XFilesTextDimBrush}"
                                    FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                    FontSize="13"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Preview content: ROM cartridge -->
                <Grid Grid.Row="1"
                    x:Name="PreviewRomPanel"
                    Visibility="Collapsed"
                    Background="#0F1318">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cover art area (centered) -->
                        <Grid Grid.Row="0"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Width="200" Height="200" Margin="0,0,0,12">
                            <Border Background="#1A2230" CornerRadius="8"
                                    BorderBrush="#2A3240" BorderThickness="1">
                                <Grid>
                                    <!-- System icon placeholder (default) -->
                                    <Image x:Name="RomSystemIcon"
                                           Width="128" Height="128"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.6"
                                           Source="ms-appx:///Assets/Views/MillerColumnsPage/rom/icons8-game-controller-128.png" />
                                    <!-- Cover art (hidden until fetched) -->
                                    <Image x:Name="RomCoverImage"
                                           Width="200" Height="200"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Game name -->
                        <TextBlock x:Name="RomTitleText" Grid.Row="1"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="18" Foreground="#FFE0E0E0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxLines="2"
                                   Margin="0,0,0,4" />

                        <!-- System + genre + players (one line) -->
                        <TextBlock x:Name="RomMetaLine1" Grid.Row="2"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="12" Foreground="#FF93C43C"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,0,0,2" />

                        <!-- Developer · Publisher -->
                        <TextBlock x:Name="RomMetaLine2" Grid.Row="3"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,2"
                                   Visibility="Collapsed" />

                        <!-- Rating · Year -->
                        <TextBlock x:Name="RomMetaLine3" Grid.Row="4"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed" />

                        <!-- Description (2-3 lines, truncated) -->
                        <TextBlock x:Name="RomDescriptionText" Grid.Row="5"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#AAFFFFFF"
                                   TextAlignment="Left"
                                   TextWrapping="Wrap"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />

                        <!-- Separator line (when gamelist data present) -->
                        <Border x:Name="RomDescSeparator" Grid.Row="6"
                                Height="1" Background="#22FFFFFF"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Visibility="Collapsed" />

                        <!-- File size (always shown at bottom of info area) -->
                        <TextBlock x:Name="RomSizeText" Grid.Row="7"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,8,0,0" />
                    </Grid>
                </Grid>

                <!-- Preview loading overlay — shown while a portal preview (REST list/download) is in flight -->
                <StackPanel Grid.Row="1"
                    x:Name="PreviewLoading"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="32" Height="32"
                                  Foreground="{StaticResource XFilesAccentBrush}" />
                    <TextBlock Text="Loading preview…"
                               Foreground="{StaticResource XFilesTextMutedBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12"
