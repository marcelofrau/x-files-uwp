                             Foreground="{StaticResource XFilesAccentBrush}"
                             Background="#2A2D33" />
                <TextBlock x:Name="FSTimeText" Grid.Column="2"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="12" Margin="12,0,0,0"
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           VerticalAlignment="Center" Text="0:00 / 0:00" />
                <TextBlock x:Name="FSVolumeText" Grid.Column="3"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="12" Margin="12,0,0,0"
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           VerticalAlignment="Center" Text="Vol 100%" />
            </Grid>
        </Grid>

        <!-- Start menu -->
        <controls:StartMenu x:Name="StartMenuControl" />

        <!-- Letter grid overlay (Jump to Letter) -->
        <controls:LetterGridOverlay x:Name="LetterGridControl" />

        <!-- Logs viewer overlay -->
        <controls:LogsPage x:Name="LogsPageControl" />
        <controls:ShareDialog x:Name="ShareDialogControl" />

        <!-- Video track menu (subtitles + audio) -->
        <controls:VideoTrackMenu x:Name="VideoTrackMenuControl" />

        <!-- About overlay -->
        <Grid x:Name="AboutOverlay" Visibility="Collapsed"
              Grid.Row="0" Grid.RowSpan="3"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Background>
                <SolidColorBrush Color="#E60D1117" />
            </Grid.Background>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="920" MaxWidth="920"
                    Background="#FF0D1117" BorderBrush="#FF93C43C" BorderThickness="2"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: brand column -->
                    <StackPanel Grid.Column="0" Grid.Row="0"
                                VerticalAlignment="Center" Margin="28,24,28,20">
                        <Image Source="ms-appx:///Assets/Wide310x150Logo.scale-200.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                        <TextBlock x:Name="AboutVersionText"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="17" Foreground="#FF93C43C"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Marcelo Frau"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="12" Foreground="#888888"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="GPL-3.0-only"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#FFD4A017"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Grid.RowSpan="2" Background="#252830" />

                    <!-- Right: links, inspirations, acknowledgements -->
                    <StackPanel Grid.Column="2" Grid.Row="0"
                                VerticalAlignment="Center" Margin="28,20,28,14">
                        <!-- Links -->
                        <TextBlock Text="PROJECT"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="10" Foreground="#55FFFFFF"
                                   CharacterSpacing="80" Margin="0,0,0,5" />

                        <HyperlinkButton x:Name="AboutGithubLink"
                                         NavigateUri="https://github.com/marcelofrau/x-files-uwp"
                                         HorizontalAlignment="Left"
                                         Padding="0"
                                         Margin="0,0,0,8">
                            <TextBlock Text="github.com/marcelofrau/x-files-uwp"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                       FontSize="12" Foreground="#FF58A6FF" />
                        </HyperlinkButton>

                        <Border Background="#252830" Height="1" Margin="0,0,0,12" />

                        <!-- Inspirations -->
                        <TextBlock Text="INSPIRED BY"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="10" Foreground="#55FFFFFF"
                                   CharacterSpacing="80" Margin="0,0,0,5" />

                        <HyperlinkButton x:Name="AboutYaziLink"
                                         NavigateUri="https://github.com/sxyazi/yazi"
                                         HorizontalAlignment="Left"
                                         Padding="0"
                                         Margin="0,0,0,2">
                            <TextBlock Text="yazi — blazing fast terminal file manager"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                       FontSize="12" Foreground="#FF58A6FF" />
                        </HyperlinkButton>

                        <TextBlock Text="Miller column navigation, keyboard-driven UX"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="10" Foreground="#55FFFFFF"
                                   Margin="0,0,0,0" />

                        <Border Background="#252830" Height="1" Margin="0,12,0,12" />

                        <!-- Acknowledgements -->
                        <TextBlock Text="COMMUNITY"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="10" Foreground="#55FFFFFF"
                                   CharacterSpacing="80" Margin="0,0,0,5" />

                        <TextBlock Text="Thanks to the emulationrevival community"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11" Foreground="#CCFFFFFF"
                                   Margin="0,0,0,2" />

                        <TextBlock FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="10" Foreground="#888888"
                                   TextWrapping="Wrap">
                            <Run Text="alouisious" Foreground="#FF93C43C" FontWeight="Bold" /> — features &amp; ideas
                        </TextBlock>

                        <TextBlock FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="10" Foreground="#888888"
                                   TextWrapping="Wrap">
                            <Run Text="MewLew" Foreground="#FF93C43C" FontWeight="Bold" />, <Run Text="Caorthann" Foreground="#FF93C43C" FontWeight="Bold" />, <Run Text="DanP142" Foreground="#FF93C43C" FontWeight="Bold" /> — support &amp; homebrew community
                        </TextBlock>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Margin="0,2,0,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                                   Width="14" Height="14" Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Back"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                       FontSize="11" Foreground="#44FFFFFF"
                                       VerticalAlignment="Center" />
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/y.png"
                                   Width="14" Height="14" Stretch="Uniform"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                            <TextBlock Text="Re-probe portal"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                       FontSize="11" Foreground="#44FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AboutPortalStatusText"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="10" Foreground="#66FFFFFF"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="28,8,28,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Placeholder screen overlay (Settings / About) -->
        <Grid x:Name="PlaceholderOverlay" Visibility="Collapsed"
              Grid.Row="0" Grid.RowSpan="3"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Background>
                <SolidColorBrush Color="#E60D1117" />
            </Grid.Background>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="600" Width="600"
                    Background="#FF1A1D23" BorderBrush="#FF2A2D33" BorderThickness="1"
                    CornerRadius="8" Padding="32,28">
                <StackPanel>
                    <TextBlock x:Name="PlaceholderTitleText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                               FontSize="22" Foreground="#FF93C43C"
                               Text="" Margin="0,0,0,8" />
                    <TextBlock x:Name="PlaceholderSubtitleText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="14" Foreground="#99FFFFFF"
                               TextWrapping="Wrap" Text="" Margin="0,0,0,20" />
                    <Border Background="#252830" Height="1" Margin="0,0,0,16" />
                    <TextBlock x:Name="PlaceholderBodyText"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="13" Foreground="#66FFFFFF"
                               TextWrapping="Wrap" Text="" />
                    <TextBlock Text="B — Back"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="11" Foreground="#44FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,28,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Error overlay -->
        <Grid x:Name="ErrorOverlay" Visibility="Collapsed"
              Grid.Row="0" Grid.RowSpan="3"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Background>
                <SolidColorBrush Color="#CC000000" />
            </Grid.Background>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="700" MaxHeight="480" Width="700" Height="480"
                    Background="#FF1A1D23" BorderBrush="#FFE04848" BorderThickness="2"
                    CornerRadius="8">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE783;" FontSize="22"
                                  Foreground="#FFE04848" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="ErrorTitleText" Grid.Column="1"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="18" Foreground="#FFE04848"
                                   VerticalAlignment="Center" Text="Error" />
                    </Grid>

                    <!-- Description -->
                    <TextBlock x:Name="ErrorDescriptionText" Grid.Row="1"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="13" Foreground="#CCFFFFFF"
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="An unexpected error occurred." />

                    <!-- Details console -->
                    <Border Grid.Row="2" Background="#FF0D1117" CornerRadius="4" Padding="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ErrorDetailsText"
                                       FontFamily="Consolas"
                                       FontSize="11" Foreground="#FF2ECC71"
                                       TextWrapping="Wrap" Padding="8,6"
                                       Text="" />
                        </ScrollViewer>
                    </Border>

                    <!-- Buttons: X=Copy, Y=Share, A/B=Close -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- X = Copy error to clipboard -->
                        <Button x:Name="BtnErrorCopy" Grid.Column="0"
                                Background="Transparent" BorderThickness="0"
                                Padding="10,6" Click="OnErrorCopyClick"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="ms-appx:///Assets/GamepadButtons/abxy/x.png"
                                       Width="26" Height="26" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="Copy" FontSize="12"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                           Foreground="#FF93C43C" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Y = Share error via gofile.io -->
                        <Button x:Name="BtnErrorShare" Grid.Column="1"
                                Background="Transparent" BorderThickness="0"
                                Padding="10,6" Click="OnErrorShareClick"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="ms-appx:///Assets/GamepadButtons/abxy/y.png"
                                       Width="26" Height="26" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                                <TextBlock x:Name="ErrorShareText" Text="Share" FontSize="12"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                           Foreground="#FF93C43C" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- A/B = Close -->
                        <Button x:Name="BtnErrorClose" Grid.Column="2"
                                Background="Transparent" BorderThickness="0"
                                Padding="10,6" Click="OnErrorCloseClick"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                                       Width="26" Height="26" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="Close" FontSize="12"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                           Foreground="#FF93C43C" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Upload progress overlay (shown during share) -->
            <Grid x:Name="ErrorUploadProgress" Visibility="Collapsed"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.Background>
                    <SolidColorBrush Color="#AA000000" />
                </Grid.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <ProgressRing IsActive="True" Width="40" Height="40"
                                  Foreground="#FF93C43C" />
                    <TextBlock x:Name="ErrorUploadStatus"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="13" Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center" Text="Preparing..." />
                </StackPanel>
            </Grid>

        </Grid>

        <!-- Controls guide overlay (fullscreen) -->
        <controls:ControlsGuideOverlay x:Name="ControlsGuideControl" />

    </Grid>
</Page>
