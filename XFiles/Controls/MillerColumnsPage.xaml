                               MaxWidth="400" Margin="0,0,0,4" />
                    <TextBlock x:Name="FsAlbumText" TextAlignment="Center"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                               FontSize="12" Foreground="{StaticResource XFilesTextDimBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               MaxWidth="350" />
                </StackPanel>
            </Grid>

            <!-- Audio visualizer canvas (shown when cycling with Select) -->
