        </Grid>

        <!-- Dialog overlays (on top of everything) -->
        <controls:FileActionSheet x:Name="FileActionSheetControl" />
        <controls:AlertDialog x:Name="AlertDialogControl" />
        <controls:InputDialog x:Name="InputDialogControl" />
        <controls:PortalSetupDialog x:Name="PortalSetupDialogControl" />
        <controls:PortalCredentialsDialog x:Name="PortalCredentialsDialogControl" />
        <controls:NetworkLocationDialog x:Name="NetworkLocationDialogControl" />
        <controls:HostKeyDialog x:Name="HostKeyDialogControl" />
        <controls:OverwriteDialog x:Name="OverwriteDialogControl" />
        <controls:FileConflictDialog x:Name="FileConflictDialogControl" />
        <controls:FileOperationConfirmDialog x:Name="FileOperationConfirmDialogControl" />
        <controls:FolderBrowserDialog x:Name="FolderBrowserDialogControl" />
        <controls:OperationProgressDialog x:Name="OpProgressDialog" />
        <controls:DiskUsageDialog x:Name="DiskUsageDialogControl" />
        <controls:PdfFullScreenOverlay x:Name="PdfFullScreen" />
        <controls:ImageFullScreenOverlay x:Name="ImageFullScreen" />
        <controls:TextEditorOverlay x:Name="TextEditorOverlayControl" />
        <controls:UrlDownloadOverlay x:Name="UrlDownloadOverlayControl" />
        <controls:SettingsPage x:Name="SettingsPageControl" />

        <!-- Fullscreen audio overlay -->
        <Grid x:Name="AudioFullScreenPanel" Visibility="Collapsed"
