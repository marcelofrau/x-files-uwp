            <MediaPlayerElement x:Name="FsAudioPlayer" Grid.Row="0" Grid.RowSpan="3"
                          AutoPlay="True" AreTransportControlsEnabled="False"
                          Visibility="Collapsed" />

            <!-- Album art + metadata -->
