                </StackPanel>
            </StackPanel>

            <!-- Clipboard indicator (center) -->
            <TextBlock x:Name="FooterClipboardIndicator"
                       Grid.Column="1"
                       Text=""
                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                       FontSize="11"
                       Foreground="#FF93C43C"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed" />

            <!-- Batch status (center) -->
            <TextBlock x:Name="FooterBatchStatus"
                       Grid.Column="1"
                       Text=""
                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                       FontSize="11"
                       Foreground="#FF93C43C"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed" />

            <!-- Status: item count + loading -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressRing x:Name="FooterSpinner"
