<UserControl
    x:Class="XFiles.Controls.FilePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117">
        <Border x:Name="MainBorder"
                Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="520"
                MaxWidth="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28,20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- header -->
                    <RowDefinition Height="Auto" />   <!-- separator -->
                    <RowDefinition Height="*" />       <!-- content -->
                    <RowDefinition Height="Auto" />   <!-- loading progress -->
                    <RowDefinition Height="Auto" />   <!-- status -->
                    <RowDefinition Height="Auto" />   <!-- footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Image x:Name="HeaderIcon"
                           Source="ms-appx:///Assets/Views/FilePropertiesDialog/filepropertiesdialog-icon-100.png"
                           Width="48" Height="48" Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Foreground="{StaticResource XFilesAccentBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="18"
                                   Text="Properties" />
                        <TextBlock x:Name="NameText"
                                   Foreground="{StaticResource XFilesForegroundBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="12"
                                   MaxWidth="440"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,2,0,0"
                                   Text="" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="#252830" Height="1" Margin="0,0,0,10" />

                <!-- Content: two columns -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />     <!-- text rows -->
                        <ColumnDefinition Width="Auto" />  <!-- visual panel (pie/compression) -->
                    </Grid.ColumnDefinitions>

                    <!-- Right column: pie chart + compression bar + info labels -->
                    <StackPanel x:Name="VisualPanel"
                                Grid.Column="1"
                                Width="200"
                                Margin="16,0,0,0"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                        <!-- Pie -->
                        <Canvas x:Name="PieHost"
                                Width="160" Height="160"
                                HorizontalAlignment="Center" />
                        <TextBlock x:Name="PieCaptionRow1"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Text="" />
                        <TextBlock x:Name="PieCaptionRow2"
                                   Foreground="{StaticResource XFilesAccentBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Text="" />
                    </StackPanel>

                    <!-- Right column: isometric compression box (archive files) -->
                    <StackPanel x:Name="CompressionVisual"
                                Grid.Column="1"
                                Width="200"
                                Margin="16,0,0,0"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                        <Canvas x:Name="CompressionCanvas"
                                Width="200" Height="240"
                                HorizontalAlignment="Center" />
                        <TextBlock x:Name="CompressionCaption"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Text="" />
                    </StackPanel>

                    <!-- Left column: rows -->
                    <ScrollViewer x:Name="RowsScrollViewer"
                                  Grid.Column="0"
                                  MaxHeight="320"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RowsPanel" MinWidth="340" />
                    </ScrollViewer>
                </Grid>

                <!-- Loading progress (below the two columns, full width) -->
                <ProgressBar x:Name="ScanProgressBar"
                             Grid.Row="3"
                             Style="{StaticResource RetroProgressBarStyle}"
                             IsIndeterminate="True"
                             Height="4"
                             MaxHeight="4"
                             Margin="0,6,0,0"
                             IsHitTestVisible="False"
                             Visibility="Collapsed" />

                <!-- Status -->
                <TextBlock x:Name="StatusText"
                           Grid.Row="4"
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Text="" />

                <!-- Footer hints (always visible, outside ScrollViewer) -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <StackPanel x:Name="PermissionsHint"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="0,0,14,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/y.png"
                               Width="12" Height="12" Margin="0,0,3,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Permissions"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="10"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                               Width="12" Height="12" Margin="0,0,3,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Close"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="10"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
