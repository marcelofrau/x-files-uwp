<UserControl
    x:Class="XFiles.Controls.FilePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117">
        <Border x:Name="MainBorder"
                Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="520"
                MaxWidth="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32,24">

            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Image x:Name="HeaderIcon"
                           Source="ms-appx:///Assets/Views/FilePropertiesDialog/filepropertiesdialog-icon-100.png"
                           Width="64" Height="64" Margin="0,0,16,0"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Foreground="{StaticResource XFilesAccentBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="20"
                                   Text="Properties" />
                        <TextBlock x:Name="NameText"
                                   Foreground="{StaticResource XFilesForegroundBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="13"
                                   MaxWidth="440"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,4,0,0"
                                   Text="" />
                    </StackPanel>
                </StackPanel>

                <Border Background="#252830" Height="1" Margin="0,0,0,12" />

                <!-- Content rows, built in code-behind -->
                <ScrollViewer x:Name="RowsScrollViewer" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RowsPanel" MinWidth="420" />
                </ScrollViewer>

                <!-- Pie (folder mode) -->
                <Canvas x:Name="PieHost"
                        Width="160" Height="160"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Visibility="Collapsed" />

                <!-- Pie caption (folder mode): folder bytes vs full drive -->
                <TextBlock x:Name="PieCaption"
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"
                           Text="" />

                <!-- Status -->
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Text="" />

                <!-- Footer hints -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0">
                    <StackPanel x:Name="PermissionsHint"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="0,0,16,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/y.png"
                               Width="14" Height="14" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Permissions"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                               Width="14" Height="14" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Close"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>