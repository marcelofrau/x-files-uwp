<UserControl
    x:Class="XFiles.Controls.FolderBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XFiles.Controls"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117"
          IsHitTestVisible="True"
          TabFocusNavigation="Local"
          XYFocusKeyboardNavigation="Disabled">
        <Border Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                MaxWidth="700"
                MinWidth="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           x:Name="TitleText"
                           Text="Select destination"
                           Foreground="{StaticResource XFilesAccentBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                           FontSize="18"
                           Padding="24,18,24,8" />

                <!-- Current path -->
                <TextBlock Grid.Row="1"
                           x:Name="CurrentPathText"
                           Text=""
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="12"
                           Padding="24,0,24,8"
                           TextTrimming="CharacterEllipsis" />

                <!-- Entry list -->
                <controls:RetroListView Grid.Row="2"
                          x:Name="EntryList"
                          Background="Transparent"
                          BorderThickness="0"
                          MaxHeight="400"
                          Padding="0"
                          Style="{StaticResource RetroListViewStyle}"
                          ItemContainerStyle="{StaticResource RetroListViewItemStyle}"
                          SelectionChanged="EntryList_SelectionChanged"
                          IsItemClickEnabled="True"
                          ItemClick="EntryList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,3,16,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       Width="24" Height="24"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />

                                <!-- Name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                           FontSize="14"
                                           Margin="0,3,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </controls:RetroListView>

                <!-- Footer separator -->
                <Border Grid.Row="3"
                        Background="#252830"
                        Height="1"
                        Margin="24,0,24,0" />

                <!-- Footer hints -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Padding="24,10,24,14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                               Width="14" Height="14" Margin="0,0,5,0"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterALabel"
                                   Text="Move Here"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                               Width="14" Height="14" Margin="0,0,5,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Back"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="11"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
