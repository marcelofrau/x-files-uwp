<UserControl
    x:Class="XFiles.Controls.HostKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#CC0D1117" Tapped="OnOverlayTapped"
          KeyDown="OnKeyDown" IsHitTestVisible="True">
        <Border Background="#1A1D23"
                BorderBrush="#2A2D33"
                BorderThickness="1"
                CornerRadius="6"
                MaxWidth="620"
                MinWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24,20">

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Image Source="ms-appx:///Assets/Views/HostKeyDialog/hostkeydialog-locked-key-100.png"
                           Width="44" Height="44"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Text="Unknown host key"
                               Foreground="{StaticResource XFilesForegroundBrush}"
                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                               FontSize="17"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="This server has not been seen before. Verify the fingerprint matches the one shown by your server (e.g. in its SSH configuration or on first-connect output), then trust it."
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Border Background="#0D1117"
                        BorderBrush="#2A2D33"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="Server"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="11" />
                        <TextBlock x:Name="HostPortText"
                                   Foreground="{StaticResource XFilesForegroundBrush}"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   Margin="0,2,0,8" />
                        <TextBlock Text="SHA256 fingerprint"
                                   Foreground="{StaticResource XFilesTextMutedBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="11" />
                        <TextBlock x:Name="FingerprintText"
                                   Foreground="{StaticResource XFilesForegroundBrush}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Once trusted, the key is remembered for this host and port. If the key changes later, the connection is refused and you can reset the trust from the network location settings."
                           Foreground="{StaticResource XFilesTextMutedBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="TrustButton"
                            Style="{StaticResource ConfirmDialogButton}"
                            Click="OnTrustClicked"
                            Margin="0,0,8,0"
                            x:FieldModifier="public">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                                   Width="18" Height="18" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="TRUST"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RejectButton"
                            Style="{StaticResource ConfirmDialogButton}"
                            Click="OnRejectClicked">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                                   Width="18" Height="18" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="REJECT"
                                       FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                       Foreground="{StaticResource XFilesForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
