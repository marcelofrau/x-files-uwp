<UserControl
    x:Class="XFiles.Controls.PortalSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Overlay" Background="#D80D1117" Tapped="OnOverlayTapped" KeyDown="OnOverlayKeyDown"
          IsHitTestVisible="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#1A1D23"
                    BorderBrush="#2A2D33"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinWidth="720"
                    MaxWidth="980"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,0,22,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0F1318"
                                BorderBrush="#2A2D33"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <Image x:Name="QrImage"
                                   Width="250"
                                   Height="250"
                                   Stretch="Uniform" />
                        </Border>
                        <TextBlock Grid.Row="1" Text="Scan → opens the official docs on how to proceed"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="12"
                                   Foreground="#D0B060"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="250"
                                   Margin="0,8,0,0" />
                    </Grid>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleText"
                                   Foreground="{StaticResource XFilesAccentBrush}"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="17"
                                   Text="Portal AppData — not connected"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="X-Files cannot reach the Xbox Developer Portal. Two things are required:"
                                   FontFamily="ms-appx:///Assets/Fonts/Inconsolata-Regular.ttf#Inconsolata"
                                   FontSize="13"
                                   Foreground="{StaticResource XFilesForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="1 · Loopback exemption (required once per reboot/re-install)"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="13"
                                   Foreground="#D0B060"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="• XB Homebrew Vault (PC) — Tools → Loopback Exempt wizard"
                                   FontFamily="ms-appx:///Assets/Fonts/Inconsolata-Regular.ttf#Inconsolata"
                                   FontSize="12"
                                   Foreground="#C8CED6"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,2" />
                        <TextBlock Text="• Release zip — tools/liberate-loopback.ps1 (Windows) or .sh (Linux/Android + sshpass)"
                                   FontFamily="ms-appx:///Assets/Fonts/Inconsolata-Regular.ttf#Inconsolata"
                                   FontSize="12"
                                   Foreground="#C8CED6"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,2" />
                        <TextBlock Text="• Manual SSH + Termux — see docs, QR on the left"
                                   FontFamily="ms-appx:///Assets/Fonts/Inconsolata-Regular.ttf#Inconsolata"
                                   FontSize="12"
                                   Foreground="#C8CED6"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,8" />

                        <TextBlock Text="2 · Portal credentials (saved on this console, not in the build)"
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                   FontSize="13"
                                   Foreground="#D0B060"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Set once in Developer Mode → Remote Access (user + password)."
                                   FontFamily="ms-appx:///Assets/Fonts/Inconsolata-Regular.ttf#Inconsolata"
                                   FontSize="12"
                                   Foreground="#C8CED6"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,10" />

                        <ProgressBar x:Name="ReprobeProgress"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Width="280"
                                     Height="4"
                                     Foreground="{StaticResource XFilesAccentGlowBrush}"
                                     Background="#1A1D23"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,8" />

                        <TextBlock x:Name="ReprobeResultText"
                                   Text=""
                                   FontFamily="ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium"
                                   FontSize="13"
                                   Foreground="#D0B060"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <Button x:Name="CredentialsBtn"
                                    Style="{StaticResource ConfirmDialogButton}"
                                    Click="OnCredentialsClicked"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/a.png"
                                           Width="18" Height="18" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                    <TextBlock x:Name="CredentialsBtnText"
                                               Text="Enter credentials"
                                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                               Foreground="{StaticResource XFilesForegroundBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ReprobeBtn"
                                    Style="{StaticResource ConfirmDialogButton}"
                                    Click="OnReprobeClicked"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/y.png"
                                           Width="18" Height="18" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="Retry"
                                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                               Foreground="{StaticResource XFilesForegroundBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CloseBtn"
                                    Style="{StaticResource ConfirmDialogButton}"
                                    Click="OnCloseClicked">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="ms-appx:///Assets/GamepadButtons/abxy/b.png"
                                           Width="18" Height="18" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="Close"
                                               FontFamily="ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium"
                                               Foreground="{StaticResource XFilesForegroundBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
