<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        X-Files Theme — dark green accent variant.
        Selection: bright green bg (#93C43C) + dark text (#252830).
        Headers/footers: dark green (#284325).
    -->

    <!-- ═══ Brushes ═══ -->
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="XFilesBackgroundBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="XFilesSurfaceBrush" Color="#1A1D23" />
    <SolidColorBrush x:Key="XFilesSurfaceAltBrush" Color="#252830" />
    <SolidColorBrush x:Key="XFilesSurfaceHoverBrush" Color="#2F333A" />
    <SolidColorBrush x:Key="XFilesCardBgBrush" Color="#1E2128" />
    <SolidColorBrush x:Key="XFilesSidebarBgBrush" Color="#0F1A0F" />
    <SolidColorBrush x:Key="XFilesInputBgBrush" Color="#0F1A0F" />

    <!-- Accent (green) -->
    <SolidColorBrush x:Key="XFilesAccentBrush" Color="#93C43C" />
    <SolidColorBrush x:Key="XFilesAccentDimBrush" Color="#7AA832" />
    <SolidColorBrush x:Key="XFilesAccentGlowBrush" Color="#B0E050" />
    <SolidColorBrush x:Key="XFilesAccentHoverDarkBrush" Color="#4A6220" />

    <!-- Text -->
    <SolidColorBrush x:Key="XFilesForegroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="XFilesTextMutedBrush" Color="#8B8D91" />
    <SolidColorBrush x:Key="XFilesTextDimBrush" Color="#5A5C60" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="XFilesSelectedBackgroundBrush" Color="#93C43C" />
    <SolidColorBrush x:Key="XFilesSelectedTextBrush" Color="#252830" />
    <SolidColorBrush x:Key="XFilesSelectedUnfocusedBrush" Color="#1E2A12" />
    <SolidColorBrush x:Key="XFilesBorderBrush" Color="#2A2D33" />
    <SolidColorBrush x:Key="XFilesDangerBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="XFilesSuccessBrush" Color="#2ECC71" />
    <SolidColorBrush x:Key="XFilesWarningBrush" Color="#F39C12" />
    <SolidColorBrush x:Key="XFilesInputBorderBrush" Color="#4A6220" />
    <SolidColorBrush x:Key="XFilesInputBorderHoverBrush" Color="#7AA832" />

    <!--
        Default TextBox/PasswordBox template resolves TextControl* theme brushes from
        the control's resource scope. Overriding them here (app-wide) keeps input
        backgrounds dark when focused instead of snapping to the light system brushes.
    -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#0F1A0F" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#101B10" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0F1A0F" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0F1A0F" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#4A6220" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#7AA832" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7AA832" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2D33" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8B8D91" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8B8D91" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8B8D91" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8B8D91" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#5A5C60" />
    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#B0D8A0" />
    <SolidColorBrush x:Key="TextControlHeaderForegroundPointerOver" Color="#B0D8A0" />
    <SolidColorBrush x:Key="TextControlHeaderForegroundFocused" Color="#B0D8A0" />

    <!-- Header/footer green -->
    <SolidColorBrush x:Key="XFilesHeaderBgBrush" Color="#284325" />
    <SolidColorBrush x:Key="XFilesFooterBgBrush" Color="#284325" />

    <!-- Title gradient (green) -->
    <LinearGradientBrush x:Key="XFilesTitleGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#7AA832" Offset="0" />
        <GradientStop Color="#93C43C" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══ Typography ═══ -->
    <FontFamily x:Key="XFilesTitleFont">ms-appx:///Assets/Fonts/Oxanium-Bold.ttf#Oxanium</FontFamily>
    <FontFamily x:Key="XFilesBodyFont">ms-appx:///Assets/Fonts/Oxanium-Regular.ttf#Oxanium</FontFamily>
    <FontFamily x:Key="XFilesMonoFontFamily">Consolas</FontFamily>

    <!-- ═══ ListView ═══ -->
    <Style x:Key="RetroListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FontFamily" Value="{StaticResource XFilesBodyFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="ScrollViewer"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      VerticalScrollMode="Enabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ ListViewItem ═══ -->
    <Style x:Key="RetroListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource XFilesBodyFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter x:Name="Presenter"
                        Content="{TemplateBinding Content}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center"
                        Padding="{TemplateBinding Padding}"
                        SelectedBackground="#93C43C"
                        SelectedForeground="#1A1D23"
                        PointerOverBackground="#1E2A12"
                        SelectedPointerOverBackground="#7AA832"
                        SelectionCheckMarkVisualEnabled="False"
                        FocusVisualMargin="0"
                        CheckBrush="Transparent"
                        CheckBoxBrush="Transparent"
                        ContentMargin="0"
                        DisabledOpacity="0.4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Button (dialog/overlay) ═══ -->
    <Style x:Key="ConfirmDialogButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource XFilesSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource XFilesForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource XFilesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource XFilesBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="Root.Background" Value="{StaticResource XFilesAccentHoverDarkBrush}" />
                                    <Setter Target="Root.BorderBrush" Value="{StaticResource XFilesAccentDimBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="Root.Background" Value="{StaticResource XFilesAccentBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="Root.Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Text input (dark theme fix) ═══ -->
    <!--
        Focused/pointer-over backgrounds are fixed app-wide by the TextControl*
        brush overrides above (they live in the control's resource scope, so the
        default template picks them up). These styles add the shared look: font,
        padding, selection/caret accents.
    -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource XFilesInputBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource XFilesForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource XFilesInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource XFilesBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource XFilesAccentBrush}" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="DarkPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource XFilesInputBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource XFilesForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource XFilesInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource XFilesBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource XFilesAccentBrush}" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!--
        ComboBox: the default template resolves ComboBox* theme brushes from the
        control's resource scope, same trick as the TextControl* overrides above,
        so the dropdown + items render dark instead of the light system defaults.
    -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0F1A0F" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#101B10" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0F1A0F" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#0F1A0F" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#0F1A0F" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#4A6220" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#7AA832" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#4A6220" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#7AA832" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#2A2D33" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#8B8D91" />
    <SolidColorBrush x:Key="ComboBoxPlaceholderForeground" Color="#8B8D91" />
    <SolidColorBrush x:Key="ComboBoxPlaceholderForegroundFocused" Color="#8B8D91" />
    <SolidColorBrush x:Key="ComboBoxPlaceholderForegroundDisabled" Color="#5A5C60" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#8B8D91" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#0F1A0F" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1E2A12" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#284325" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#93C43C" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOverUnfocused" Color="#1E2A12" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#1E2A12" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="#0F1A0F" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#1A1D23" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOverUnfocused" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#5A5C60" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrush" Color="#2A2D33" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="#7AA832" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="#7AA832" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="#93C43C" />
    <SolidColorBrush x:Key="ComboBoxHeaderForeground" Color="#B0D8A0" />
    <SolidColorBrush x:Key="ComboBoxHeaderForegroundPointerOver" Color="#B0D8A0" />
    <SolidColorBrush x:Key="ComboBoxHeaderForegroundFocused" Color="#B0D8A0" />
    <SolidColorBrush x:Key="ComboBoxHeaderForegroundDisabled" Color="#8B8D91" />

    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource XFilesInputBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource XFilesForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource XFilesInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource XFilesBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <!-- ═══ Progress bar (operation dialog) ═══ -->
    <Style x:Key="RetroProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource XFilesAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource XFilesBorderBrush}" />
        <Setter Property="Height" Value="14" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Determinate">
                                    <VisualState.Setters>
                                        <Setter Target="ProgressBarIndicator.Visibility" Value="Visible" />
                                        <Setter Target="IndeterminateBar.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate">
                                    <VisualState.Setters>
                                        <Setter Target="ProgressBarIndicator.Visibility" Value="Collapsed" />
                                        <Setter Target="IndeterminateBar.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:2.2"
                                                             From="-280"
                                                             To="1400"
                                                             AutoReverse="True"
                                                             RepeatBehavior="Forever"
                                                             Storyboard.TargetName="IndeterminateBar"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" />
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle x:Name="TrackRound"
                                   Fill="{TemplateBinding Background}"
                                   RadiusX="3"
                                   RadiusY="3" />
                        <Rectangle x:Name="ProgressBarIndicator"
                                   Fill="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Left"
                                   Stretch="Fill"
                                   RadiusX="3"
                                   RadiusY="3" />
                        <Rectangle x:Name="IndeterminateBar"
                                   Visibility="Collapsed"
                                   Fill="{TemplateBinding Foreground}"
                                   Width="240"
                                   HorizontalAlignment="Left"
                                   RadiusX="3"
                                   RadiusY="3">
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="-280" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
